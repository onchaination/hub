---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { localeFromPath, localePath } from '../lib/locales';
import { ui } from '../lib/ui';
import Site from '../layouts/Site.astro';
import { levels, loadItems, root } from '../lib/content';
import { sections, sectionKeys, REPO } from '../lib/site';
const items = loadItems();
const locale = localeFromPath(Astro.url.pathname);
const t = ui[locale];
const link = (path: string) => localePath(path, locale);
// The project's principles own the homepage introduction.
const readme = readFileSync(resolve(root, 'README.md'), 'utf8');
const introduction = readme.match(
  /<!-- home:intro -->\s*([\s\S]*?)\s*<!-- \/home:intro -->/,
)?.[1];
if (!introduction) throw new Error('README.md needs a home:intro block');
const tags = [...new Set(items.flatMap((item) => item.tags))].sort();
const levelEmojis = {
  beginner: '🦐',
  intermediate: '🐟',
  advanced: '🐋',
};
---

<Site title={t.intro} socialImage="/og.png">
  <div class="shell">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="open-dot" aria-hidden="true"></span> {t.hub}
        </p>
        <h1>
          {t.hero}
          <br />
          <span class="muted">{t.heroAction}</span>
        </h1>
        <p class="hero-lede">{locale === 'en' ? introduction : t.intro}</p>
        <div class="actions">
          <a class="button primary" href={link('/learn')}>
            😎 {t.start} <span aria-hidden="true">→</span>
          </a>
          <a class="button" href="https://t.me/onchaination_group">
            👋 {t.join} ↗
          </a>
        </div>
        <p class="hero-note">{t.heroNote}</p>
      </div>
      <div class="hero-note-block">
        <span class="large-mark" aria-hidden="true">
          ▣
        </span>
        <p>{t.openDefault}</p>
        <span class="eyebrow">{t.neutral}</span>
      </div>
    </section>
    <section class="path-grid" aria-label={t.choosePath}>
      {sectionKeys.map((key) => (
        <a class="path" href={link(`/${key}`)}>
          <h2>
            <span class="path-heading">
              <span class="path-emoji" aria-hidden="true">
                {sections[key].emoji}
              </span>
              {t[key]}
            </span>
            <span class="path-arrow" aria-hidden="true">
              ↗
            </span>
          </h2>
          <p class="path-purpose">{t[`${key}Purpose`]}</p>
          <p class="muted small">{t[`${key}Description`]}</p>
        </a>
      ))}
    </section>
    <section class="browse-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{t.start}</p>
          <h2>{t.startingPoint} 🤔</h2>
        </div>
        <a class="text-link symbol-link" href={link('/search')}>
          <span class="link-label">{t.searchAll}</span>
          <span class="link-symbol" aria-hidden="true">
            ↗
          </span>
        </a>
      </div>
      <p class="muted">{t.browseAll}</p>
      <div class="level-grid">
        {levels.map((level) => {
          const label = t[level];
          return (
            <a class="level-card" href={link(`/levels/${level}`)}>
              <h3>
                <span class="level-emoji" aria-hidden="true">
                  {levelEmojis[level]}
                </span>
                {label}
              </h3>
              <p class="level-description">{t[`${level}Description`]}</p>
              <span class="level-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          );
        })}
      </div>
    </section>
    <section class="topic-section">
      <p class="eyebrow">{t.related}</p>
      <h2>{t.exploreTopic} 📍</h2>
      <div class="topic-links">
        {tags.map((tag) => (
          <a href={link(`/tags/${tag}`)}>
            #{tag}
            <span>
              {items.filter((item) => item.tags.includes(tag)).length}
            </span>
          </a>
        ))}
      </div>
    </section>
    <section class="contribute-banner">
      <div>
        <p class="eyebrow">{t.contribute}</p>
        <h2>{t.improve}</h2>
      </div>
      <div>
        <p>{t.contributionSteps}</p>
        <a class="button primary" href={`${REPO}/blob/main/CONTRIBUTING.md`}>
          {t.contribute} 🚀
        </a>
      </div>
    </section>
  </div>
</Site>
