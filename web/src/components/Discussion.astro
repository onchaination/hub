---
import { localeFromPath, getContentKey, localePath } from '../lib/locales';
import { ui } from '../lib/ui';
import { SITE } from '../lib/site';
const t = ui[localeFromPath(Astro.url.pathname)];
const contentKey = getContentKey(Astro.url.pathname);
---

<section
  class="discussion"
  data-content-key={contentKey}
  data-discussion-url={SITE + localePath(contentKey)}
  data-pagefind-ignore
  aria-labelledby="discussion-title"
>
  <h2 id="discussion-title">💬 {t.discussion}</h2>
  <p class="muted">{t.discussionNote}</p>
  <details class="discussion-embed">
    <summary>{t.loadComments}</summary>
    <div id="telegram-comments"></div>
  </details>
  <p class="small muted">
    <a href="https://t.me/onchaination_info">{t.updates} ↗</a> ·{' '}
    <a href="https://t.me/onchaination_group">{t.forum} ↗</a>
  </p>
</section>
<script>
  const discussion = document.querySelector<HTMLElement>('.discussion');
  const details =
    discussion?.querySelector<HTMLDetailsElement>('.discussion-embed');

  const loadDiscussion = () => {
    if (!details || !details.open || details.dataset.loaded) return;
    details.dataset.loaded = 'true';
    const script = document.createElement('script');
    script.src = 'https://telegram.org/js/telegram-widget.js?22';
    script.async = true;
    script.dataset.telegramDiscussion = 'onchaination_info';
    script.dataset.pageUrl = discussion!.dataset.discussionUrl!;
    script.dataset.commentsLimit = '5';
    const dark = document.documentElement.dataset.theme === 'dark';
    script.dataset.dark = dark ? '1' : '0';
    script.dataset.color = dark ? 'eeeeee' : '111111';
    script.dataset.colorful = '0';
    discussion?.querySelector('#telegram-comments')?.append(script);
  };

  details?.addEventListener('toggle', loadDiscussion);

  if (discussion && details && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        observer.disconnect();
        details.open = true;
        loadDiscussion();
      },
      { threshold: 0.1 },
    );
    observer.observe(discussion);
  }
</script>
