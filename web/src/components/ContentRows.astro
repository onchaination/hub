---
import { levels, resolveContent, type Item } from '../lib/content';
import { localePath, type Locale } from '../lib/locales';
import { ui } from '../lib/ui';
import { sections } from '../lib/site';
interface Props {
  items: Item[];
  showSection?: boolean;
  language?: Locale;
}
const { items, showSection = true, language = 'en' } = Astro.props;
const t = ui[language];
const translatedItems = items
  .map((item) => resolveContent(item, language))
  .sort(
    (a, b) =>
      levels.indexOf(a.level ?? 'beginner') -
        levels.indexOf(b.level ?? 'beginner') ||
      a.title.localeCompare(b.title, language),
  );
---

<div class="content-rows">
  {items.length === 0 && <p>{t.empty}</p>}
  {translatedItems.map((item, index) => {
    return (
      <article class="content-row">
        <span class="row-number" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </span>
        <div class="row-copy">
          {showSection && (
            <span class="eyebrow row-section">
              {sections[item.section].emoji} {t[item.section]}
            </span>
          )}
          <h3>
            <a class="symbol-link" href={item.route} lang={item.language}>
              <span class="link-label">{item.title}</span>
              <span class="link-symbol row-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </h3>
          <p lang={item.language}>{item.description}</p>
          <div class="tags">
            {item.tags.map((tag) => (
              <a href={localePath(`/tags/${tag}`, language)}>#{tag}</a>
            ))}
          </div>
        </div>
        {item.level && (
          <a
            class="row-level"
            href={localePath(`/levels/${item.level}`, language)}
          >
            {t[item.level]}
          </a>
        )}
      </article>
    );
  })}
</div>
