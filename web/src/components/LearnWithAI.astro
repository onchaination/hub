---
import type { Item } from '../lib/content';
import { aiContext } from '../integrations/ai/context';
import { providers } from '../integrations/ai/providers';
interface Props {
  item: Item;
}
const { item } = Astro.props;
---

<details class="ai-panel" data-pagefind-ignore>
  <summary>
    ✨ Learn with AI <span class="muted">Bring your own curiosity</span>
  </summary>
  <div class="ai-content">
    <p>
      Copy this context, open your preferred assistant, and paste it to start a
      conversation.
    </p>
    <label class="sr-only" for="ai-context">
      Context for your AI assistant
    </label>
    <textarea id="ai-context" readonly rows="7">{aiContext(item)}</textarea>
    <div class="actions">
      <button type="button" class="button primary" id="copy-context">
        Copy context
      </button>
      {providers.map((provider) => (
        <a
          class="button"
          href={provider.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {provider.name} ↗
        </a>
      ))}
    </div>
    <p id="copy-status" class="small muted" role="status">
      You can also select and copy the text manually.
    </p>
  </div>
</details>
<script>
  document
    .querySelector('#copy-context')
    ?.addEventListener('click', async () => {
      const textarea =
        document.querySelector<HTMLTextAreaElement>('#ai-context')!;
      const status = document.querySelector('#copy-status')!;
      try {
        await navigator.clipboard.writeText(textarea.value);
        status.textContent = 'Copied. Open an assistant and paste the context.';
      } catch {
        textarea.focus();
        textarea.select();
        status.textContent =
          'Copy the selected text manually, then paste it into your assistant.';
      }
    });
</script>
