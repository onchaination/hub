---
import { ui } from '../lib/ui';
import type { Item } from '../lib/content';
import { aiContext } from '../integrations/ai/context';
import { providers } from '../integrations/ai/providers';
interface Props {
  item: Item;
}
const { item } = Astro.props;
const t = ui[item.interfaceLocale];
---

<details class="ai-panel" data-pagefind-ignore>
  <summary>✨ {t.aiTitle}</summary>
  <div class="ai-content">
    <p>{t.aiNote}</p>
    <label class="sr-only" for="ai-context">
      {t.aiTitle}
    </label>
    <textarea id="ai-context" readonly rows="7">{aiContext(item)}</textarea>
    <div class="actions">
      <button type="button" class="button primary" id="copy-context">
        {t.copyContext}
      </button>
      {providers.map((provider) => (
        <a
          class="button"
          href={provider.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {provider.name} ↗
        </a>
      ))}
    </div>
    <p
      id="copy-status"
      data-copied={t.copied}
      data-manual={t.copyManual}
      class="small muted"
      role="status"
    >
      {t.copyManual}
    </p>
  </div>
</details>
<script>
  document
    .querySelector('#copy-context')
    ?.addEventListener('click', async () => {
      const textarea =
        document.querySelector<HTMLTextAreaElement>('#ai-context')!;
      const status = document.querySelector<HTMLElement>('#copy-status')!;
      try {
        await navigator.clipboard.writeText(textarea.value);
        status.textContent = status.dataset.copied!;
      } catch {
        textarea.focus();
        textarea.select();
        status.textContent = status.dataset.manual!;
      }
    });
</script>
