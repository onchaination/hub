---
import { ui } from '../lib/ui';
import { localeFromPath } from '../lib/locales';
const locale = localeFromPath(Astro.url.pathname);
import type { Part } from '../lib/content';
import Widget from '../widgets/Widget';
interface Props {
  parts: Part[];
}
const { parts } = Astro.props;
---

{parts.map((part) => {
  if ('html' in part) return <Fragment set:html={part.html} />;
  return (
    <>
      <Widget
        name={part.name}
        props={part.props}
        locale={locale}
        client:visible
      />
      <noscript>
        <p>{ui[locale].calculatorNoJS}</p>
      </noscript>
    </>
  );
})}
