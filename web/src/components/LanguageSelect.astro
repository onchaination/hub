---
import { locales, localePath, localeFromPath } from '../lib/locales';
import { languageName } from '../lib/languages';
import { ui } from '../lib/ui';
const locale = localeFromPath(Astro.url.pathname);
const t = ui[locale];
const route = /^\/404(?:\.html)?\/?$/.test(Astro.url.pathname)
  ? '/'
  : Astro.url.pathname;
---

<details class="language-select">
  <summary>
    <span class="sr-only">{t.language}: </span>
    <span class="language-name" lang={locale}>
      {languageName(locale)}
    </span>
    <span class="language-code" aria-hidden="true">
      {locale.toUpperCase()}
    </span>
    <span aria-hidden="true"> ▾</span>
  </summary>
  <nav aria-label={t.language}>
    {locales.map((language) => (
      <a
        href={localePath(route, language)}
        lang={language}
        aria-current={locale === language ? 'page' : undefined}
      >
        {languageName(language)}
      </a>
    ))}
  </nav>
</details>
