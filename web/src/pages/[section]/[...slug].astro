---
import Site from '../../layouts/Site.astro';
import Markdown from '../../components/Markdown.astro';
import LearnWithAI from '../../components/LearnWithAI.astro';
import Discussion from '../../components/Discussion.astro';
import ContentRows from '../../components/ContentRows.astro';
import LanguageSelect from '../../components/LanguageSelect.astro';
import {
  loadItems,
  renderMarkdown,
  relatedItems,
  availableLanguages,
  contentRoute,
  translationFor,
  type Item,
} from '../../lib/content';
import { REPO, sections } from '../../lib/site';
import { ogImageRoute } from '../../lib/og';
export function getStaticPaths() {
  const items = loadItems();
  return items.flatMap((item) =>
    Object.keys(item.translations).map((language) => ({
      params: {
        section: item.section,
        slug: item.id + (language === 'en' ? '' : '/' + language),
      },
      props: {
        item: translationFor(item, language)!,
      },
    })),
  );
}
interface Props {
  item: Item;
}
const { item } = Astro.props;
const items = loadItems();
const languages = availableLanguages(items);
const alternates = Object.keys(item.translations).map((language) => ({
  language,
  route: contentRoute(item, language),
}));
const { parts, headings } = await renderMarkdown(item.body, item.file, items);
const related = relatedItems(item, items).filter((relatedItem) =>
  translationFor(relatedItem, item.language),
);
---

<Site
  title={item.title}
  description={item.description}
  markdown={`/${item.file}`}
  language={item.language}
  canonicalPath={contentRoute(item)}
  socialImage={ogImageRoute(item)}
  socialImageAlt={`${item.title} · Onchaination`}
  alternates={alternates}
>
  <div class="shell article-layout">
    <aside class="article-sidebar">
      <LanguageSelect item={item} languages={languages} />
      <div class="on-this-page" aria-label="On this page">
        <p class="eyebrow">On this page</p>
        <nav>
          {headings.map((heading) => (
            <a href={`#${heading.id}`}>{heading.text}</a>
          ))}
        </nav>
        <div class="aside-note">
          <span aria-hidden="true">↗</span>
          <p>
            Found a clearer way
            <br />
            to explain this?
          </p>
          <a href={`${REPO}/edit/main/${item.file}`}>Make it better</a>
        </div>
      </div>
    </aside>
    <article
      class="article"
      data-pagefind-body
      data-content-id={item.id}
      data-pagefind-meta="id[data-content-id]"
      lang={item.language}
    >
      <header class="article-heading">
        <a class="eyebrow breadcrumb symbol-link" href={`/${item.section}`}>
          <span class="link-symbol link-symbol-back" aria-hidden="true">
            ←
          </span>
          <span class="link-label" data-pagefind-filter="Type">
            {sections[item.section].label}
          </span>
        </a>
        <h1 data-pagefind-meta="title">{item.title}</h1>
        <p class="lead" data-pagefind-meta="description">
          {item.description}
        </p>
        <div class="tags">
          {item.tags.map((tag) => (
            <a href={`/tags/${tag}`} data-pagefind-filter="Tags">
              #{tag}
            </a>
          ))}
        </div>
        <div class="article-meta">
          {item.level && (
            <a href={`/levels/${item.level}`} data-pagefind-filter="Level">
              {item.level}
            </a>
          )}
          {item.updated && (
            <span>
              Updated <time datetime={item.updated}>{item.updated}</time>
            </span>
          )}
          <span>
            {Math.max(1, Math.ceil(item.body.split(/\s+/).length / 220))} min
            read
          </span>
        </div>
        <div class="source-links" data-pagefind-ignore>
          <a class="symbol-link" href={`${REPO}/edit/main/${item.file}`}>
            <span class="link-label">Edit on GitHub</span>
            <span class="link-symbol" aria-hidden="true">
              ↗
            </span>
          </a>
          <a class="symbol-link" href={`${REPO}/blob/main/${item.file}`}>
            <span class="link-label">View source</span>
            <span class="link-symbol" aria-hidden="true">
              ↗
            </span>
          </a>
          <a class="symbol-link" href={`/${item.file}`}>
            <span class="link-label">Markdown</span>
            <span class="link-symbol link-symbol-down" aria-hidden="true">
              ↓
            </span>
          </a>
        </div>
      </header>
      <LearnWithAI item={item} />
      <div class="prose">
        <Markdown parts={parts} />
      </div>
    </article>
    <div class="article-after">
      {related.length > 0 && (
        <section class="related">
          <p class="eyebrow">Keep exploring</p>
          <h2>Related knowledge</h2>
          <ContentRows items={related} language={item.language} />
        </section>
      )}
      <Discussion />
    </div>
  </div>
</Site>
