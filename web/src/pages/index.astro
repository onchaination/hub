---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Site from '../layouts/Site.astro';
import { levels, loadItems, root } from '../lib/content';
import { sections, sectionKeys, REPO } from '../lib/site';
const items = loadItems();
// The project's principles own the homepage introduction.
const readme = readFileSync(resolve(root, 'README.md'), 'utf8');
const introduction = readme.match(
  /<!-- home:intro -->\s*([\s\S]*?)\s*<!-- \/home:intro -->/,
)?.[1];
if (!introduction) throw new Error('README.md needs a home:intro block');
const tags = [...new Set(items.flatMap((item) => item.tags))].sort();
const levelDescriptions = {
  beginner:
    'New here or building the foundations. Start with clear explanations of core onchain concepts.',
  intermediate:
    'Comfortable with the basics and ready to go further. Connect concepts with tools and practical workflows.',
  advanced:
    'Explore deeper systems, trade-offs and strategies across protocols and networks.',
};
const levelEmojis = {
  beginner: '🦐',
  intermediate: '🐟',
  advanced: '🐋',
};
---

<Site title="Learn, build and share value onchain" socialImage="/og.png">
  <div class="shell">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="open-dot" aria-hidden="true"></span> An open knowledge
          hub
        </p>
        <h1>
          Understand more.
          <br />
          <span class="muted">Do something useful.</span>
        </h1>
        <p class="hero-lede">{introduction}</p>
        <div class="actions">
          <a class="button primary" href="/learn">
            😎 Start here <span aria-hidden="true">→</span>
          </a>
          <a class="button" href="https://t.me/onchaination_group">
            👋 Join the group ↗
          </a>
        </div>
        <p class="hero-note">For curious humans and capable agents.</p>
      </div>
      <div class="hero-note-block">
        <span class="large-mark" aria-hidden="true">
          ▣
        </span>
        <p>
          Open by default.
          <br />
          Useful by contribution.
        </p>
        <span class="eyebrow">Chain neutral · Built in public</span>
      </div>
    </section>
    <section class="path-grid" aria-label="Choose your path">
      {sectionKeys.map((key) => (
        <a class="path" href={`/${key}`}>
          <h2>
            <span class="path-heading">
              <span class="path-emoji" aria-hidden="true">
                {sections[key].emoji}
              </span>
              {sections[key].label}
            </span>
            <span class="path-arrow" aria-hidden="true">
              ↗
            </span>
          </h2>
          <p class="path-purpose">{sections[key].purpose}</p>
          <p class="muted small">{sections[key].description}</p>
        </a>
      ))}
    </section>
    <section class="browse-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Start where you are</p>
          <h2>Find your starting point 🤔</h2>
        </div>
        <a class="text-link symbol-link" href="/search">
          <span class="link-label">Search all knowledge</span>
          <span class="link-symbol" aria-hidden="true">
            ↗
          </span>
        </a>
      </div>
      <p class="muted">
        Explore knowledge at different depths, or start with the basics.
      </p>
      <div class="level-grid">
        {levels.map((level) => {
          const label = level[0].toUpperCase() + level.slice(1);
          return (
            <a class="level-card" href={`/levels/${level}`}>
              <h3>
                <span class="level-emoji" aria-hidden="true">
                  {levelEmojis[level]}
                </span>
                {label}
              </h3>
              <p class="level-description">{levelDescriptions[level]}</p>
              <span class="level-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          );
        })}
      </div>
    </section>
    <section class="topic-section">
      <p class="eyebrow">Connect the dots</p>
      <h2>Explore a topic 📍</h2>
      <div class="topic-links">
        {tags.map((tag) => (
          <a href={`/tags/${tag}`}>
            #{tag}
            <span>
              {items.filter((item) => item.tags.includes(tag)).length}
            </span>
          </a>
        ))}
      </div>
    </section>
    <section class="contribute-banner">
      <div>
        <p class="eyebrow">Grow by building</p>
        <h2>
          Your next discovery
          <br />
          could improve something 🌱
        </h2>
      </div>
      <div>
        <p>
          <b>Share ideas. Explain a concept. Create value.</b>
          <br />
          Small, useful contributions are how this grows.
        </p>
        <a class="button primary" href={`${REPO}/blob/main/CONTRIBUTING.md`}>
          Make your contribution 🚀
        </a>
      </div>
    </section>
  </div>
</Site>
