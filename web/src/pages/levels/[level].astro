---
import Site from '../../layouts/Site.astro';
import ContentRows from '../../components/ContentRows.astro';
import { levels, loadItems, type Level } from '../../lib/content';

export function getStaticPaths() {
  return levels.map((level) => ({ params: { level } }));
}

const level = Astro.params.level as Level;
const items = loadItems().filter((item) => item.level === level);
const label = level[0].toUpperCase() + level.slice(1);
---

<Site
  title={`${label} level`}
  description={`Explore ${level}-level knowledge across Learn, Tools, Strategies, and Skills.`}
>
  <div class="shell section-page">
    <header class="page-heading">
      <p class="eyebrow">Knowledge matched to your experience</p>
      <h1>{label}</h1>
      <p class="lead">
        {items.length} {items.length === 1 ? 'page' : 'pages'} to help you
        understand and put that knowledge into practice.
      </p>
    </header>
    <ContentRows items={items} />
  </div>
</Site>
