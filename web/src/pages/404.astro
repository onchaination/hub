---
import Site from '../layouts/Site.astro';
---

<Site title="Page not found" noindex>
  <div class="reading-page">
    <p class="eyebrow">404 / A missing connection</p>
    <h1>This page isn't here.</h1>
    <p class="lead">It may have moved, or the link may be incomplete.</p>
    <div class="actions">
      <a class="button primary" href="/search">
        Search the hub →
      </a>
      <a class="button" href="/">
        Back to home
      </a>
    </div>
  </div>
</Site>
