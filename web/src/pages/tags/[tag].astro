---
import Browse from '../../views/Browse.astro';
import { loadItems, tagAliases } from '../../lib/content';
export function getStaticPaths() {
  const tags = [...new Set(loadItems().flatMap((item) => item.tags))];
  const aliases = Object.entries(tagAliases()).filter(
    ([alias, key]) => alias !== key && tags.includes(key),
  );
  return [
    ...tags.map((tag) => ({ params: { tag }, props: { canonical: tag } })),
    ...aliases.map(([tag, canonical]) => ({
      params: { tag },
      props: { canonical },
    })),
  ];
}
if (Astro.props.canonical !== Astro.params.tag)
  return Astro.redirect(`/tags/${Astro.props.canonical}/`, 301);
---

<Browse kind="tags" value={Astro.params.tag!} />
