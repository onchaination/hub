---
import Site from '../layouts/Site.astro';
import ContentRows from '../components/ContentRows.astro';
import { loadItems, tagAliases, availableLanguages } from '../lib/content';
import { languageName } from '../lib/languages';
import { sectionKeys, sections } from '../lib/site';
const items = loadItems();
---

<Site title="Search" noindex>
  <div class="shell section-page">
    <header class="page-heading">
      <p class="eyebrow">Find your way in</p>
      <h1>Search the hub.</h1>
      <p class="lead">
        A concept, a question, or a hashtag. Start with what you're curious
        about.
      </p>
    </header>
    <form
      id="search-form"
      class="search-form"
      role="search"
      data-aliases={JSON.stringify(tagAliases())}
      data-languages={JSON.stringify(availableLanguages(items))}
      data-items={JSON.stringify(
        Object.fromEntries(
          items.map((item) => [
            item.id,
            {
              directory: item.directory,
              languages: Object.keys(item.translations),
            },
          ]),
        ),
      )}
    >
      <label for="query" class="sr-only">
        Search knowledge
      </label>
      <input
        id="query"
        name="q"
        type="search"
        placeholder="Try transactions, fees, or #wallets…"
        autocomplete="off"
      />
      <label for="section-filter" class="sr-only">
        Content type
      </label>
      <select id="section-filter" name="type">
        <option value="">All paths</option>
        {sectionKeys.map((section) => (
          <option value={sections[section].label}>
            {sections[section].label}
          </option>
        ))}
      </select>
      <label for="language-filter" class="sr-only">
        Content language
      </label>
      <select id="language-filter" name="lang">
        {availableLanguages(items).map((language) => (
          <option value={language}>{languageName(language)}</option>
        ))}
      </select>
      <button class="button primary" type="submit">
        Search →
      </button>
    </form>
    <p id="search-status" class="muted small" role="status">
      Browse all {items.length} pages below, or search by a word or topic.
    </p>
    <noscript>
      <p>
        Text search needs JavaScript. All pages are listed below; you can also
        browse by topic.
      </p>
    </noscript>
    <div id="search-results" hidden></div>
    <button id="more-results" class="button" type="button" hidden>
      Load more results
    </button>
    <div id="browse-fallback">
      <ContentRows items={items} />
    </div>
  </div>
</Site>
<script>
  type Data = {
    url: string;
    meta: { id: string; title?: string; description?: string };
  };
  type Engine = {
    search(
      query: string | null,
      options: { filters: Record<string, string> },
    ): Promise<{ results: { data(): Promise<Data> }[] }>;
  };
  type Pagefind = { createInstance(): Engine };
  const form = document.querySelector<HTMLFormElement>('#search-form')!;
  const input = document.querySelector<HTMLInputElement>('#query')!;
  const type = document.querySelector<HTMLSelectElement>('#section-filter')!;
  const language =
    document.querySelector<HTMLSelectElement>('#language-filter')!;
  const status = document.querySelector('#search-status')!;
  const output = document.querySelector<HTMLDivElement>('#search-results')!;
  const fallback = document.querySelector<HTMLDivElement>('#browse-fallback')!;
  const more = document.querySelector<HTMLButtonElement>('#more-results')!;
  const aliases: Record<string, string> = JSON.parse(form.dataset.aliases!);
  const catalogue: Record<string, { directory: string; languages: string[] }> =
    JSON.parse(form.dataset.items!);
  const engines = new Map<string, Engine>();
  let generation = 0;
  let results: Data[] = [];
  let shown = 0;
  function showMore() {
    for (const result of results.slice(shown, shown + 20)) {
      const row = document.createElement('article');
      row.className = 'search-result';
      const heading = document.createElement('h2');
      const link = document.createElement('a');
      link.href = result.url;
      link.textContent = result.meta.title ?? result.url;
      const description = document.createElement('p');
      description.textContent = result.meta.description ?? '';
      heading.append(link);
      row.append(heading, description);
      output.append(row);
    }
    shown += 20;
    more.hidden = shown >= results.length;
  }
  async function search(updateUrl = true) {
    const version = ++generation;
    const requested = language.value || 'en';
    const params = new URLSearchParams();
    if (input.value.trim()) params.set('q', input.value.trim());
    if (type.value) params.set('type', type.value);
    if (requested !== 'en') params.set('lang', requested);
    if (updateUrl)
      history.replaceState(
        null,
        '',
        '/search' + (params.size ? '?' + params.toString() : ''),
      );
    if (!params.size) {
      output.hidden = true;
      more.hidden = true;
      fallback.hidden = false;
      status.textContent =
        'Browse all items below, or search by a word or topic.';
      return;
    }
    status.textContent = 'Searching…';
    more.hidden = true;
    try {
      const term = input.value
        .toLowerCase()
        .replace(/#/g, '')
        .trim()
        .split(/\s+/)
        .map((word) => (Object.hasOwn(aliases, word) ? aliases[word] : word))
        .join(' ');
      // Search one representation per item: requested language, plus English only
      // for items without that translation. No duplicate translation entries.
      const batches = await Promise.all(
        [...new Set([requested, 'en'])].map(async (lang) => {
          if (!engines.has(lang)) {
            // Separate module instances give each language its own Pagefind worker
            // and stemming WASM. Sharing one worker mixes language index state.
            const bundle = '/pagefind/pagefind.js?language=' + lang;
            const pagefind = (await import(
              /* @vite-ignore */ bundle
            )) as Pagefind;
            // Pagefind captures the document language synchronously when creating
            // an instance. Restore the English interface language immediately.
            const documentLanguage = document.documentElement.lang;
            try {
              document.documentElement.lang = lang;
              engines.set(lang, pagefind.createInstance());
            } finally {
              document.documentElement.lang = documentLanguage;
            }
          }
          const response = await engines.get(lang)!.search(term || null, {
            filters: type.value ? { Type: type.value } : {},
          });
          const data = await Promise.all(
            response.results.map((result) => result.data()),
          );
          return data.filter(
            (result) =>
              lang === requested ||
              !catalogue[result.meta.id]?.languages.includes(requested),
          );
        }),
      );
      if (version !== generation) return;
      results = [
        ...new Map(
          batches.flat().map((result) => [result.meta.id, result]),
        ).values(),
      ].map((result) => ({
        ...result,
        url: catalogue[result.meta.id]
          ? '/' +
            catalogue[result.meta.id].directory +
            (requested === 'en' ? '' : '/' + requested)
          : result.url,
      }));
      shown = 0;
      output.replaceChildren();
      output.hidden = false;
      fallback.hidden = true;
      status.textContent = results.length
        ? results.length +
          (results.length === 1 ? ' result found.' : ' results found.')
        : 'No matching pages. Try a broader word or choose All paths.';
      showMore();
    } catch {
      if (version !== generation) return;
      engines.clear();
      output.hidden = true;
      more.hidden = true;
      fallback.hidden = false;
      status.textContent = import.meta.env.DEV
        ? 'Search is generated during the build. Run npm run build, then npm run preview. Browse all items below.'
        : 'Search could not load. Try again, or browse every item below.';
    }
  }
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    void search();
  });
  type.addEventListener('change', () => void search());
  language.addEventListener('change', () => void search());
  let timer: ReturnType<typeof setTimeout>;
  input.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(() => void search(), 180);
  });
  more.addEventListener('click', showMore);
  function restore() {
    const params = new URLSearchParams(location.search);
    input.value = params.get('q') ?? '';
    type.value = params.get('type') ?? '';
    language.value = params.get('lang') ?? 'en';
    if (!language.value) language.value = 'en';
    void search(false);
  }
  window.addEventListener('popstate', restore);
  restore();
</script>
